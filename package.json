{
  "name": "spursx2-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx --env-file=.env pipeline/worker.ts",
    "worker:once": "tsx --env-file=.env pipeline/worker.ts --once",
    "demo:moment": "tsx --env-file=.env scripts/enqueue-demo-moment.ts",
    "demo:replay": "tsx --env-file=.env scripts/replay.ts",
    "test:render": "tsx scripts/render-test.ts",
    "test:scoreplay": "tsx scripts/scoreplay-test.ts",
    "test:rules": "tsx scripts/rules-test.ts",
    "test:engine": "tsx scripts/engine-test.ts",
    "test:storage": "tsx scripts/storage-test.ts",
    "test:e2e": "tsx --env-file=.env scripts/pipeline-e2e.ts",
    "test": "npm run test:unit && npm run test:render && npm run test:production && npm run test:e2e",
    "test:real": "tsx --env-file=.env scripts/real-footage-proof.ts",
    "footage:map": "tsx --env-file=.env scripts/build-footage-map.ts",
    "test:publish": "tsx scripts/publish-test.ts",
    "test:hygiene": "tsx scripts/hygiene-test.ts",
    "purge:media": "tsx scripts/purge-local-media.ts --all",
    "test:unit": "npm run test:rules && npm run test:scoreplay && npm run test:engine && npm run test:storage && npm run test:publish && npm run test:hygiene && npm run test:writeback && npm run test:metadata",
    "test:writeback": "tsx scripts/writeback-test.ts",
    "test:metadata": "tsx scripts/metadata-test.ts",
    "test:production": "tsx scripts/production-test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.12",
    "@typesafe-ai/sdk": "^0.7.0",
    "drizzle-orm": "latest",
    "postgres": "latest",
    "twelvelabs-js": "^1.3.6",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
