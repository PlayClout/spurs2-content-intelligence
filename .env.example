# Real credentials stay in an untracked .env. Never commit secrets.
DATABASE_URL=
SCOREPLAY_API_KEY=
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=
MOCK_MODE=1
RENDER_STORAGE=local
RENDER_OUT_DIR=out/renders
# Writes require taxonomy sign-off, a durable DB settings adapter, and BOTH kill switches off.
SCOREPLAY_WRITES=0
SCOREPLAY_WRITE_KILL_SWITCH=1
# Only set SCOREPLAY_WRITES=1 and SCOREPLAY_WRITE_KILL_SWITCH=0 after human sign-off.
# DB kill switch must also be false. Missing/unavailable DB state always holds writes.
# Rights tag options are provisioned by the human after taxonomy sign-off, never auto-created here.
SCOREPLAY_RIGHTS_TAG_IDS={}
