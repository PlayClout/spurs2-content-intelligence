# Spurs² Content Intelligence worker — runs the job queue: TwelveLabs analyze, rights, ffmpeg render, ScorePlay write-back.
# Linux container (ffmpeg uses libx264, not the M-series videotoolbox encoder the M5 uses). Runs anywhere: Fargate, the M5, a client cloud.
FROM node:22-bookworm-slim

# ffmpeg (render + probe) and fontconfig (so @napi-rs/canvas can rasterize the bundled TTFs for captions/cards)
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg fontconfig ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install deps against the lockfile first for layer caching. The worker needs the ROOT package (pipeline/, shared/, scripts/),
# not web/, so copy only the root manifests.
COPY package.json package-lock.json ./
# Full install (tsx is a devDependency but it IS the runtime: without it `npx tsx` downloads from npm on
# every container start = slow boots and a hard dependency on the npm registry being reachable).
RUN npm ci --no-audit --no-fund

# App code the worker touches. web/ is intentionally excluded (that deploys to Vercel).
COPY pipeline ./pipeline
COPY shared ./shared
COPY scripts ./scripts
COPY data ./data

ENV NODE_ENV=production
# Fargate/Railway health check hits this; also the port the orchestrator maps.
ENV WORKER_HEALTH_PORT=8080
EXPOSE 8080

# Run the local tsx binary directly (no npx network lookup). DATABASE_URL etc. come from the env at run time.
CMD ["node_modules/.bin/tsx", "pipeline/worker.ts"]
