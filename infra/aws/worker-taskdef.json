{
  "family": "spurs2-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "runtimePlatform": { "cpuArchitecture": "ARM64", "operatingSystemFamily": "LINUX" },
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::271825827331:role/spurs2-worker-exec",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "271825827331.dkr.ecr.us-east-1.amazonaws.com/spurs2-worker:becc5c1",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "WORKER_HEALTH_PORT", "value": "8080" },
        { "name": "RENDER_STORAGE", "value": "s3" },
        { "name": "RENDER_S3_BUCKET", "value": "clout-ci-renders-271825827331" },
        { "name": "RENDER_S3_REGION", "value": "us-east-1" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:us-east-1:271825827331:secret:spurs2/worker-B2m0Le:DATABASE_URL::" },
        { "name": "TWELVELABS_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:271825827331:secret:spurs2/worker-B2m0Le:TWELVELABS_API_KEY::" },
        { "name": "SCOREPLAY_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:271825827331:secret:spurs2/worker-B2m0Le:SCOREPLAY_API_KEY::" },
        { "name": "TYPESAFE_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:271825827331:secret:spurs2/worker-B2m0Le:TYPESAFE_API_KEY::" },
        { "name": "ANTHROPIC_API_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:271825827331:secret:spurs2/worker-B2m0Le:ANTHROPIC_API_KEY::" },
        { "name": "RENDER_S3_ACCESS_KEY_ID", "valueFrom": "arn:aws:secretsmanager:us-east-1:271825827331:secret:spurs2/worker-B2m0Le:RENDER_S3_ACCESS_KEY_ID::" },
        { "name": "RENDER_S3_SECRET_ACCESS_KEY", "valueFrom": "arn:aws:secretsmanager:us-east-1:271825827331:secret:spurs2/worker-B2m0Le:RENDER_S3_SECRET_ACCESS_KEY::" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"require('http').get('http://localhost:8080',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/spurs2-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
